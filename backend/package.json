{
  "name": "pantrio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Pantrio API — authentication service for the grocery inventory app",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "morgan": "^1.10.1"
  },
  "overridesRationale": {
    "qs": "Express 4 pins a qs release with two open moderate advisories (array-limit bypass, isBuffer DoS). 6.16.0 is API-compatible and patches both. Remove once Express depends on a fixed version."
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.2.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testTimeout": 30000
  }
}
