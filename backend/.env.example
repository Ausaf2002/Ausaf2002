# Copy this file to backend/.env and fill in the real values.
# .env is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string.
# Atlas: Database > Connect > Drivers, then replace <password> with the real
# password and add the database name before the "?" (here: pantrio).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pantrio?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signing key for JWTs. Use a long random string — anyone who has it can mint
# tokens for any account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token lifetime. The brief calls for 24 hours.
JWT_EXPIRES_IN=24h

# bcrypt cost factor. 12 is the project standard; raising it slows both
# attackers and your own login endpoint.
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Rate limiting (applies to /api/auth/register and /api/auth/login)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Number of reverse proxies in front of this service (Heroku/Render/nginx = 1).
# Keep 0 when the app is directly exposed: over-trusting proxy headers lets a
# caller spoof their IP and bypass the rate limiter.
TRUST_PROXY_HOPS=0
